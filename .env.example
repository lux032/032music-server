MUSIC_SERVER_PORT=4533
MUSIC_SERVER_DATA_PATH=./data
MUSIC_SERVER_MUSIC_PATH=/path/to/your/music
MUSIC_SERVER_LIBRARY_NAME=Music
MUSIC_SERVER_ADMIN_USERNAME=admin
MUSIC_SERVER_ADMIN_PASSWORD=replace-with-at-least-12-characters
MUSIC_SERVER_API_TOKEN=replace-with-a-random-token-at-least-24-characters
MUSIC_SERVER_MEDIA_TOKEN=replace-with-a-different-random-token-at-least-24-characters
MUSIC_SERVER_LOG_LEVEL=info
MUSIC_SERVER_COOKIE_SECURE=false
MUSIC_SERVER_DEV_MODE=false
# ffmpeg executable (default: ffmpeg on PATH)
MUSIC_SERVER_FFMPEG_PATH=ffmpeg
MUSIC_SERVER_TRANSCODE_LIVE_MAX=4
MUSIC_SERVER_TRANSCODE_CACHE_JOBS=2
MUSIC_SERVER_TRANSCODE_CACHE_MB=4096
MUSIC_SERVER_THUMB_CACHE_MB=512
# Sonos / DLNA casting (optional). Speakers fetch audio from this LAN address,
# e.g. http://192.168.1.10:4533 (host IP + MUSIC_SERVER_PORT).
MUSIC_SERVER_CAST_BASE_URL=
# Speakers to probe when multicast cannot reach the container (bridge network):
# Sonos IPs (port 1400 assumed) or DLNA device description URLs, comma-separated.
MUSIC_SERVER_CAST_DEVICES=
